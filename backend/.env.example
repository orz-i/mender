# The API reads process environment variables; .env files are not loaded automatically.
MENDER_HTTP_ADDR=127.0.0.1:18080

# Additional Run list/events read surface; requires the authenticated Run API.
MENDER_RUN_READ_API_ENABLED=false
# When enabled, inject 32 cryptographically random bytes encoded as 43-character
# unpadded base64url; use the same protected key on each API replica. Never log it.
# MENDER_CURSOR_SIGNING_KEY=

# Default remains probes-only. No migration or seeded credentials at API startup.
MENDER_RUN_API_ENABLED=false
# Optional public StartRun admission. Requires 0006 and a separate append-only
# admission writer in the SAME database; plan facts are read via MENDER_DATABASE_URL.
MENDER_RUN_START_API_ENABLED=false
# MENDER_ADMISSION_DATABASE_URL=postgres://mender_admission:<admission-password>@127.0.0.1:5432/mender?sslmode=disable
# Provision only an existing role with: pnpm db:grant-admission --role mender_admission
# Never reuse the owner, reader, or cancellation credentials for admission.
# Optional coordinated cancellation of admitted but provably unexecuted Runs.
# Requires 0005 migration and a separate restricted role in the SAME database.
MENDER_RUN_COORDINATED_CANCEL_ENABLED=false
# MCP 2026-07-28 stateless meta-tool gateway. This is NOT a bypass route:
# enabling it requires Run read + StartRun + coordinated cancellation and their
# existing restricted DB roles. The same machine API Key is authenticated and
# bound to /mcp/v1/workspaces/{workspace_id} before the MCP SDK handles JSON-RPC.
MENDER_MCP_GATEWAY_ENABLED=false
# Fixed Toolset direct business-tool distribution. Requires the authenticated
# MCP gateway and publishes only bindings that explicitly opt in with a stable
# mcp_name + fixed Connection. A valid credential without run:create can
# complete MCP discovery but receives an empty tools/list surface; tools/call
# re-authorizes run:create before durable Admission.
MENDER_MCP_FIXED_TOOLSET_ENABLED=false
# Upstream MCP client is intentionally NOT enabled by an ambient boolean here.
# A host must explicitly construct a reviewed SupplierMCPRuntime with a distinct
# mcp_connector DB role, reviewed egress allowlist and SecretProvider. The
# default API/Worker bootstrap therefore stays fail-closed for remote MCP egress.
# Provider cancellation only records/uses durable upstream cancel intent after
# coordinated safe-cancel proves the Run was already submitted. It does not add
# a provider network cancel adapter to the API process.
MENDER_RUN_PROVIDER_CANCEL_ENABLED=false
# Enabling this flag only persists provider cancel intent after safe-cancel says
# the Run was already submitted. The API process still performs no provider
# network cancellation; a separately reviewed provider-control runtime is needed.
# MENDER_CANCELLATION_DATABASE_URL=postgres://mender_cancel:<cancel-password>@127.0.0.1:5432/mender?sslmode=disable
# Provision only an existing role with: pnpm db:grant-cancellation --role mender_cancel
# Never reuse the owner, reader, or admission-writer credentials for cancellation.
# MENDER_DATABASE_URL=postgres://mender_app:<runtime-password>@127.0.0.1:5432/mender?sslmode=disable

# Worker process: local SQL lease-control only. Default false keeps the worker idle.
# When enabled the current process only recovers expired leases; it does not dispatch
# fresh work or contact any supplier. Use a dedicated role in the SAME database.
MENDER_WORKER_CONTROL_ENABLED=false
# Dispatch can only run through an explicitly reviewed runtime that supplies a separate
# executor DB role, egress allowlist and SecretProvider. The default cmd/worker wires no
# SecretProvider, so setting this true still fails startup closed before DB/network use.
MENDER_WORKER_DISPATCH_ENABLED=false
# MENDER_WORKER_DATABASE_URL=postgres://mender_worker:<worker-password>@127.0.0.1:5432/mender?sslmode=disable
# MENDER_WORKER_ID=worker_local_01
# MENDER_WORKER_WORKSPACES=ws_local
# MENDER_WORKER_POLL_INTERVAL=1s
# MENDER_WORKER_DEPLOYMENT_REVISIONS=deploy_http_v1
# MENDER_WORKER_LEASE_TTL=30s
# MENDER_WORKER_HEARTBEAT_INTERVAL=10s
# MENDER_WORKER_ACTIVATION_LIMIT=10
# Provision only an existing role with: pnpm db:grant-worker --role mender_worker
# Never reuse the owner, runtime reader, admission writer, or cancellation writer.

# Provider HTTP status/cancel control is intentionally NOT configurable by the
# default API/Worker environment. The reviewed library composition requires a
# separately injected executor DB role, reconciler DB role, reviewed provider
# IDs/egress allowlist and a production SecretProvider. Do not add ambient
# MENDER_PROVIDER_* URLs or secret values to make local development "work".
# Migration 0013 only stores reviewed fixed status/cancel endpoints on Supply
# deployments; applying it does not enable provider network traffic.

# Usage settlement is also a reviewed library composition, not an ambient
# API/Worker feature flag. Provision a dedicated role only when a reviewed host
# is added: pnpm db:grant-settlement --role mender_settlement. That principal
# can consume pending terminal settlement jobs and update Commerce quota facts,
# but cannot read canonical arguments, Connections, Supply or Identity. Do not
# reuse API/worker/executor/reconciler/cancellation credentials for settlement.
# Migrations 0014-0015 add quota settlement contracts/jobs; they do not enable
# payments, revenue accounting or a background settlement scheduler.

# Operator process only: never configure API with this elevated connection.
# MENDER_ADMIN_DATABASE_URL=postgres://<migration-owner>:<password>@127.0.0.1:5432/mender?sslmode=disable
# Non-loopback PostgreSQL connections require verified TLS (sslmode=verify-full).

# Artifact v1 has no independent public flag or object-store configuration. When
# MENDER_RUN_READ_API_ENABLED=true, authenticated run:read callers can access the
# Run's bounded inline JSON Artifact endpoints through the same restricted runtime
# DB role. After migration 0016 re-run db:grant-runtime for that role; never grant
# source_observation_id or provider_observations to make result reads work.
