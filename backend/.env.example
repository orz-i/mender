# The API reads process environment variables; .env files are not loaded automatically.
MENDER_HTTP_ADDR=127.0.0.1:18080

# Additional Run list/events read surface; requires the authenticated Run API.
MENDER_RUN_READ_API_ENABLED=false
# When enabled, inject 32 cryptographically random bytes encoded as 43-character
# unpadded base64url; use the same protected key on each API replica. Never log it.
# MENDER_CURSOR_SIGNING_KEY=

# Default remains probes-only. No migration or seeded credentials at API startup.
MENDER_RUN_API_ENABLED=false
# Optional public StartRun admission. Requires 0006 and a separate append-only
# admission writer in the SAME database; plan facts are read via MENDER_DATABASE_URL.
MENDER_RUN_START_API_ENABLED=false
# MENDER_ADMISSION_DATABASE_URL=postgres://mender_admission:<admission-password>@127.0.0.1:5432/mender?sslmode=disable
# Provision only an existing role with: pnpm db:grant-admission --role mender_admission
# Never reuse the owner, reader, or cancellation credentials for admission.
# Optional coordinated cancellation of admitted but provably unexecuted Runs.
# Requires 0005 migration and a separate restricted role in the SAME database.
MENDER_RUN_COORDINATED_CANCEL_ENABLED=false
# MENDER_CANCELLATION_DATABASE_URL=postgres://mender_cancel:<cancel-password>@127.0.0.1:5432/mender?sslmode=disable
# Provision only an existing role with: pnpm db:grant-cancellation --role mender_cancel
# Never reuse the owner, reader, or admission-writer credentials for cancellation.
# MENDER_DATABASE_URL=postgres://mender_app:<runtime-password>@127.0.0.1:5432/mender?sslmode=disable

# Worker process: local SQL lease-control only. Default false keeps the worker idle.
# When enabled the current process only recovers expired leases; it does not dispatch
# fresh work or contact any supplier. Use a dedicated role in the SAME database.
MENDER_WORKER_CONTROL_ENABLED=false
# Dispatcher application seam exists, but no production supplier executor is wired.
# Setting this true currently fails startup closed instead of enabling network calls.
MENDER_WORKER_DISPATCH_ENABLED=false
# MENDER_WORKER_DATABASE_URL=postgres://mender_worker:<worker-password>@127.0.0.1:5432/mender?sslmode=disable
# MENDER_WORKER_ID=worker_local_01
# MENDER_WORKER_WORKSPACES=ws_local
# MENDER_WORKER_POLL_INTERVAL=1s
# Provision only an existing role with: pnpm db:grant-worker --role mender_worker
# Never reuse the owner, runtime reader, admission writer, or cancellation writer.

# Operator process only: never configure API with this elevated connection.
# MENDER_ADMIN_DATABASE_URL=postgres://<migration-owner>:<password>@127.0.0.1:5432/mender?sslmode=disable
# Non-loopback PostgreSQL connections require verified TLS (sslmode=verify-full).
