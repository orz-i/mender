# The API reads process environment variables; .env files are not loaded automatically.
MENDER_HTTP_ADDR=127.0.0.1:18080

# Human Console OIDC login. Default false means no /auth/login, browser session,
# Workspace self-service or human Connection routes are registered. Enabling it
# currently requires MENDER_RUN_API_ENABLED=true so the Console shares the same
# explicitly configured API process but uses a distinct browser-session DB role.
MENDER_CONSOLE_OIDC_ENABLED=false
# MENDER_BROWSER_SESSION_DATABASE_URL=postgres://mender_browser:<browser-session-password>@127.0.0.1:5432/mender?sslmode=disable
# Provision only an existing unprivileged role: pnpm db:grant-browser-session --role mender_browser
# MENDER_CONSOLE_OIDC_ISSUER=https://idp.example.com
# MENDER_CONSOLE_OIDC_CLIENT_ID=mender-console
# Client secret and flow-signing key are mounted files, never browser variables.
# MENDER_CONSOLE_OIDC_CLIENT_SECRET_FILE=/run/secrets/mender_oidc_client_secret
# Signing-key file content: 32 random bytes as 43-char unpadded base64url.
# MENDER_CONSOLE_FLOW_SIGNING_KEY_FILE=/run/secrets/mender_console_flow_key
# MENDER_CONSOLE_OIDC_REDIRECT_URL=https://mender.example.com/auth/callback
# MENDER_CONSOLE_SESSION_TTL=8h
# Secure cookies default true. false is accepted only with loopback http redirect.
MENDER_CONSOLE_COOKIE_SECURE=true
# Explicit short-lived Human -> Run delegation. The OIDC session cookie itself
# never authenticates Run endpoints. When enabled, Console can mint an opaque
# in-memory Bearer token scoped only to run:read and optionally run:cancel.
# Requires Console OIDC + Run read API and reuses the browser-session DB role
# only for identity/delegation facts; it still cannot access Execution tables.
MENDER_CONSOLE_RUN_DELEGATION_ENABLED=false
# MENDER_CONSOLE_RUN_DELEGATION_TTL=10m
# Read-only Human launch discovery. Returns only published Toolset/ToolVersion
# bindings with an active current-user Connection grant and active pricing/budget
# window. It never returns credential refs, budget balances or Provider secrets.
MENDER_CONSOLE_LAUNCH_DISCOVERY_ENABLED=false
# Human Connection self-service is a separate capability and DB principal. It
# can list safe Connection metadata and revoke only; it cannot read credential
# version refs, Connection grants, machine keys, Run data or Supplier secrets.
MENDER_CONSOLE_CONNECTIONS_ENABLED=false
# MENDER_CONNECTION_MANAGER_DATABASE_URL=postgres://mender_connection_manager:<password>@127.0.0.1:5432/mender?sslmode=disable
# Provision only an existing role: pnpm db:grant-connection-manager --role mender_connection_manager
# Reviewed OAuth Connection Alpha. Browser input never selects provider
# endpoints/scopes and never receives access/refresh tokens. All provider
# endpoints, scopes and client credentials below are server-owned config.
MENDER_CONSOLE_CONNECTION_OAUTH_ENABLED=false
# MENDER_CONNECTION_OAUTH_PROVIDER_ID=reviewed_provider
# MENDER_CONNECTION_OAUTH_AUTHORIZATION_URL=https://provider.example/oauth/authorize
# MENDER_CONNECTION_OAUTH_TOKEN_URL=https://provider.example/oauth/token
# MENDER_CONNECTION_OAUTH_CLIENT_ID=mender-console
# MENDER_CONNECTION_OAUTH_CLIENT_SECRET_FILE=/run/secrets/provider-oauth-client-secret
# MENDER_CONNECTION_OAUTH_REDIRECT_URL=https://mender.example/api/console/v1/connections/oauth/callback
# MENDER_CONNECTION_OAUTH_SCOPES=profile.read,resources.read
# MENDER_CONNECTION_OAUTH_SECRET_ROOT=/var/lib/mender/connection-secrets
# MENDER_CONNECTION_OAUTH_FLOW_TTL=10m

# Additional Run list/events read surface; requires the authenticated Run API.
MENDER_RUN_READ_API_ENABLED=false
# When enabled, inject 32 cryptographically random bytes encoded as 43-character
# unpadded base64url; use the same protected key on each API replica. Never log it.
# MENDER_CURSOR_SIGNING_KEY=

# Default remains probes-only. No migration or seeded credentials at API startup.
MENDER_RUN_API_ENABLED=false
# Optional public StartRun admission. Requires 0006 and a separate append-only
# admission writer in the SAME database; plan facts are read via MENDER_DATABASE_URL.
MENDER_RUN_START_API_ENABLED=false
# MENDER_ADMISSION_DATABASE_URL=postgres://mender_admission:<admission-password>@127.0.0.1:5432/mender?sslmode=disable
# Provision only an existing role with: pnpm db:grant-admission --role mender_admission
# Never reuse the owner, reader, or cancellation credentials for admission.
# Optional coordinated cancellation of admitted but provably unexecuted Runs.
# Requires 0005 migration and a separate restricted role in the SAME database.
MENDER_RUN_COORDINATED_CANCEL_ENABLED=false
# MCP 2026-07-28 stateless meta-tool gateway. This is NOT a bypass route:
# enabling it requires Run read + StartRun + coordinated cancellation and their
# existing restricted DB roles. The same machine API Key is authenticated and
# bound to /mcp/v1/workspaces/{workspace_id} before the MCP SDK handles JSON-RPC.
MENDER_MCP_GATEWAY_ENABLED=false
# Fixed Toolset direct business-tool distribution. Requires the authenticated
# MCP gateway and publishes only bindings that explicitly opt in with a stable
# mcp_name + fixed Connection. A valid credential without run:create can
# complete MCP discovery but receives an empty tools/list surface; tools/call
# re-authorizes run:create before durable Admission.
MENDER_MCP_FIXED_TOOLSET_ENABLED=false
# Upstream MCP client is intentionally NOT enabled by an ambient boolean here.
# A host must explicitly construct a reviewed SupplierMCPRuntime with a distinct
# mcp_connector DB role, reviewed egress allowlist and SecretProvider. The
# default API/Worker bootstrap therefore stays fail-closed for remote MCP egress.
# Provider cancellation only records/uses durable upstream cancel intent after
# coordinated safe-cancel proves the Run was already submitted. It does not add
# a provider network cancel adapter to the API process.
MENDER_RUN_PROVIDER_CANCEL_ENABLED=false
# Enabling this flag only persists provider cancel intent after safe-cancel says
# the Run was already submitted. The API process still performs no provider
# network cancellation; a separately reviewed provider-control runtime is needed.
# MENDER_CANCELLATION_DATABASE_URL=postgres://mender_cancel:<cancel-password>@127.0.0.1:5432/mender?sslmode=disable
# Provision only an existing role with: pnpm db:grant-cancellation --role mender_cancel
# Never reuse the owner, reader, or admission-writer credentials for cancellation.
# MENDER_DATABASE_URL=postgres://mender_app:<runtime-password>@127.0.0.1:5432/mender?sslmode=disable

# Worker process: local SQL lease-control only. Default false keeps the worker idle.
# When enabled the current process only recovers expired leases; it does not dispatch
# fresh work or contact any supplier. Use a dedicated role in the SAME database.
MENDER_WORKER_CONTROL_ENABLED=false
# Dispatch can only run through an explicitly reviewed runtime that supplies a separate
# executor DB role, exact egress allowlist and mounted SecretProvider. This flag alone
# is insufficient; reviewed host composition below must also be explicitly enabled.
MENDER_WORKER_DISPATCH_ENABLED=false
# MENDER_WORKER_DATABASE_URL=postgres://mender_worker:<worker-password>@127.0.0.1:5432/mender?sslmode=disable
# MENDER_WORKER_ID=worker_local_01
# MENDER_WORKER_WORKSPACES=ws_local
# MENDER_WORKER_POLL_INTERVAL=1s
# MENDER_WORKER_DEPLOYMENT_REVISIONS=deploy_http_v1
# MENDER_WORKER_LEASE_TTL=30s
# MENDER_WORKER_HEARTBEAT_INTERVAL=10s
# MENDER_WORKER_ACTIVATION_LIMIT=10
# Provision only an existing role with: pnpm db:grant-worker --role mender_worker
# Never reuse the owner, runtime reader, admission writer, or cancellation writer.

# Reviewed worker runtime host. Default false preserves the old fail-closed worker:
# no supplier egress, provider control, secret read or settlement composition occurs.
MENDER_REVIEWED_WORKER_RUNTIME_ENABLED=false
MENDER_REVIEWED_HTTP_DISPATCH_ENABLED=false
MENDER_REVIEWED_PROVIDER_CONTROL_ENABLED=false
MENDER_REVIEWED_SETTLEMENT_ENABLED=false

# Supplier credentials are NEVER placed in environment variables. Mount an
# operator/secret-manager controlled directory and provision files using the
# deterministic hash documented in the runnable Alpha engineering record.
# MENDER_REVIEWED_SECRET_ROOT=/run/secrets/mender
# MENDER_EXECUTOR_DATABASE_URL=postgres://mender_executor:<executor-password>@127.0.0.1:5432/mender?sslmode=disable
# Exact comma-separated DNS host allowlist; no URL, path, wildcard or model input.
# MENDER_REVIEWED_EGRESS_ALLOWED_HOSTS=api.example.com
MENDER_REVIEWED_EGRESS_ALLOW_HTTP=false
MENDER_REVIEWED_EGRESS_ALLOW_LOOPBACK=false

# Provider status/cancel additionally requires a distinct reconciler role and a
# reviewed provider-ID allowlist. Fixed endpoint URLs still come only from
# Supply Deployment facts; there is no MENDER_PROVIDER_URL override.
# MENDER_RECONCILER_DATABASE_URL=postgres://mender_reconciler:<reconciler-password>@127.0.0.1:5432/mender?sslmode=disable
# MENDER_REVIEWED_PROVIDER_IDS=provider_example

# Settlement may be enabled without supplier egress but still requires worker
# control/explicit Workspace scope and its own minimal database role.
# MENDER_SETTLEMENT_DATABASE_URL=postgres://mender_settlement:<settlement-password>@127.0.0.1:5432/mender?sslmode=disable
# Provision with: pnpm db:grant-settlement --role mender_settlement
# This is quota/usage settlement only, not payment, revenue or supplier payout.

# Operator process only: never configure API with this elevated connection.
# MENDER_ADMIN_DATABASE_URL=postgres://<migration-owner>:<password>@127.0.0.1:5432/mender?sslmode=disable
# Non-loopback PostgreSQL connections require verified TLS (sslmode=verify-full).

# Artifact v1 has no independent public flag or object-store configuration. When
# MENDER_RUN_READ_API_ENABLED=true, authenticated run:read callers can access the
# Run's bounded inline JSON Artifact endpoints through the same restricted runtime
# DB role. After migration 0016 re-run db:grant-runtime for that role; never grant
# source_observation_id or provider_observations to make result reads work.
