{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "plugin_id",
    "version",
    "kind",
    "kernel_abi",
    "artifact",
    "config_schema_file",
    "tool_files",
    "permissions",
    "limits",
    "ui"
  ],
  "properties": {
    "apiVersion": {
      "const": "mender.io/plugin/v1alpha1"
    },
    "plugin_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "kind": {
      "enum": [
        "declarative-http"
      ]
    },
    "kernel_abi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "major",
        "min_minor"
      ],
      "properties": {
        "major": {
          "const": 1
        },
        "min_minor": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "media_type",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "const": "application/vnd.mender.declarative+json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "config_schema_file": {
      "type": "string",
      "minLength": 1
    },
    "tool_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "egress",
        "secret_capabilities",
        "filesystem"
      ],
      "properties": {
        "egress": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scheme",
              "host",
              "ports"
            ],
            "properties": {
              "scheme": {
                "const": "https"
              },
              "host": {
                "type": "string",
                "minLength": 1
              },
              "ports": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            }
          }
        },
        "secret_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "filesystem": {
          "const": "none"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_ms",
        "max_request_bytes",
        "max_response_bytes",
        "max_results"
      ],
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "max_request_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_results": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_file"
      ],
      "properties": {
        "schema_file": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.test/mender/plugin-manifest-v1alpha1.json",
  "title": "Mender PluginManifest v1alpha1 — design sample"
}
