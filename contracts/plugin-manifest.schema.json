{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.test/mender/plugin-manifest-v1alpha1.json",
  "title": "Mender governed PluginManifest v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "plugin_id",
    "version",
    "publisher_id",
    "display_name",
    "description",
    "capabilities"
  ],
  "properties": {
    "apiVersion": {
      "const": "mender.io/plugin/v1alpha1"
    },
    "plugin_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "publisher_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "tool_version_id"],
            "properties": {
              "kind": { "const": "api_tool" },
              "tool_version_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "tool_version_id"],
            "properties": {
              "kind": { "const": "mcp_tool" },
              "tool_version_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "deployment_revision"],
            "properties": {
              "kind": { "const": "agent" },
              "deployment_revision": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              }
            }
          }
        ]
      }
    }
  }
}
