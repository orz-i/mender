{
  "kind": "declarative-http",
  "method": "GET",
  "endpoint_ref": "company_api",
  "endpoint": {
    "scheme": "https",
    "host": "api.example.test",
    "port": 443,
    "path": "/v1/companies"
  },
  "parameters": {
    "query.q": {
      "input_pointer": "/query"
    },
    "query.limit": {
      "input_pointer": "/limit"
    }
  },
  "authentication": {
    "mode": "broker",
    "capability": "provider.request"
  },
  "response": {
    "items_pointer": "/items",
    "meter": {
      "unit": "result",
      "count_pointer": "/items"
    }
  },
  "retry": {
    "class": "read_only",
    "max_attempts": 2
  }
}
