{
  "name": "mender",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mender — Agent 能力集成、治理与分发平台",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": { "node": "24.19.0", "pnpm": "11.18.0" },
  "scripts": {
    "preinstall": "node scripts/check-toolchain.mjs",
    "dev": "pnpm --filter @mender/console --filter @mender/admin --parallel run dev",
    "dev:console": "pnpm --filter @mender/console dev",
    "dev:admin": "pnpm --filter @mender/admin dev",
    "dev:api": "node scripts/backend.mjs run ./cmd/api",
    "dev:worker": "node scripts/backend.mjs run ./cmd/worker",
    "build": "pnpm --filter @mender/console --filter @mender/admin run build",
    "build:backend": "node scripts/backend.mjs build ./...",
    "lint": "eslint frontend scripts eslint.config.mjs --max-warnings 0",
    "typecheck": "pnpm -r run typecheck",
    "test": "node --test scripts/architecture.test.mjs scripts/postgres-test.test.mjs scripts/g3-evidence.test.mjs scripts/alpha-operations.test.mjs scripts/alpha-closure.test.mjs scripts/s4a-plugin-publication.test.mjs scripts/s4b-release-governance.test.mjs scripts/s4c-dangerous-operation-jit.test.mjs scripts/s4d-platform-admin.test.mjs scripts/s403-commerce-billing.test.mjs scripts/s406-sandbox-payment.test.mjs frontend/packages/api-client/src/health.test.mjs frontend/packages/api-client/src/runs.test.mjs frontend/packages/api-client/src/console-identity.test.mjs frontend/packages/api-client/src/console-connections.test.mjs frontend/packages/api-client/src/console-run-delegation.test.mjs frontend/packages/api-client/src/console-launch.test.mjs frontend/packages/api-client/src/console-start-run.test.mjs frontend/packages/api-client/src/console-execution-risk.test.mjs frontend/packages/api-client/src/console-usage.test.mjs frontend/packages/api-client/src/console-catalog.test.mjs frontend/packages/api-client/src/admin-governance.test.mjs",
    "test:backend": "node scripts/backend.mjs test ./...",
    "test:integration": "node scripts/backend.mjs test -tags=integration -count=1 -timeout=120s ./tests/integration",
    "test:integration:docker": "node scripts/test-postgres.mjs",
    "db:migrate": "node scripts/backend.mjs run ./cmd/operator migrate",
    "db:grant-runtime": "node scripts/backend.mjs run ./cmd/operator grant-runtime",
    "db:grant-browser-session": "node scripts/backend.mjs run ./cmd/operator grant-browser-session",
    "db:grant-connection-manager": "node scripts/backend.mjs run ./cmd/operator grant-connection-manager",
    "db:grant-oauth-refresher": "node scripts/backend.mjs run ./cmd/operator grant-oauth-refresher",
    "db:grant-catalog-manager": "node scripts/backend.mjs run ./cmd/operator grant-catalog-manager",
    "db:grant-publisher-manager": "node scripts/backend.mjs run ./cmd/operator grant-publisher-manager",
    "db:grant-release-manager": "node scripts/backend.mjs run ./cmd/operator grant-release-manager",
    "db:grant-dangerous-operation-manager": "node scripts/backend.mjs run ./cmd/operator grant-dangerous-operation-manager",
    "db:grant-support-reader": "node scripts/backend.mjs run ./cmd/operator grant-support-reader",
    "db:grant-platform-admin-manager": "node scripts/backend.mjs run ./cmd/operator grant-platform-admin-manager",
    "db:grant-billing-manager": "node scripts/backend.mjs run ./cmd/operator grant-billing-manager",
    "db:grant-payment-manager": "node scripts/backend.mjs run ./cmd/operator grant-payment-manager",
    "db:grant-payment-callback-ingestor": "node scripts/backend.mjs run ./cmd/operator grant-payment-callback-ingestor",
    "db:grant-governance-reviewer": "node scripts/backend.mjs run ./cmd/operator grant-governance-reviewer",
    "db:grant-governance-policy-manager": "node scripts/backend.mjs run ./cmd/operator grant-governance-policy-manager",
    "db:grant-governance-execution-confirmer": "node scripts/backend.mjs run ./cmd/operator grant-governance-execution-confirmer",
    "db:grant-commerce-observer": "node scripts/backend.mjs run ./cmd/operator grant-commerce-observer",
    "db:grant-admission": "node scripts/backend.mjs run ./cmd/operator grant-admission",
    "db:grant-cancellation": "node scripts/backend.mjs run ./cmd/operator grant-cancellation",
    "db:grant-worker": "node scripts/backend.mjs run ./cmd/operator grant-worker",
    "db:grant-executor": "node scripts/backend.mjs run ./cmd/operator grant-executor",
    "db:grant-mcp-connector": "node scripts/backend.mjs run ./cmd/operator grant-mcp-connector",
    "db:grant-reconciler": "node scripts/backend.mjs run ./cmd/operator grant-reconciler",
    "db:grant-callback-ingestor": "node scripts/backend.mjs run ./cmd/operator grant-callback-ingestor",
    "db:grant-callback-observer": "node scripts/backend.mjs run ./cmd/operator grant-callback-observer",
    "db:grant-settlement": "node scripts/backend.mjs run ./cmd/operator grant-settlement",
    "db:grant-artifact-materializer": "node scripts/backend.mjs run ./cmd/operator grant-artifact-materializer",
    "db:grant-artifact-object-reader": "node scripts/backend.mjs run ./cmd/operator grant-artifact-object-reader",
    "key:issue": "node scripts/backend.mjs run ./cmd/operator issue-key",
    "key:revoke": "node scripts/backend.mjs run ./cmd/operator revoke-key",
    "human:provision": "node scripts/backend.mjs run ./cmd/operator provision-human",
    "human:provision-platform-staff": "node scripts/backend.mjs run ./cmd/operator provision-platform-staff",
    "vet:backend": "node scripts/backend.mjs vet ./...",
    "check:toolchain": "node scripts/check-toolchain.mjs --go",
    "check:workspace": "node scripts/check-workspace.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:g3": "node scripts/check-g3-evidence.mjs",
    "check:alpha-operations": "node scripts/check-alpha-operations.mjs",
    "check:alpha": "node scripts/check-alpha-closure.mjs",
    "check:s4a-plugin-publication": "node scripts/check-s4a-plugin-publication.mjs",
    "check:s4b-release-governance": "node scripts/check-s4b-release-governance.mjs",
    "check:s4c-dangerous-operation-jit": "node scripts/check-s4c-dangerous-operation-jit.mjs",
    "check:s4d-platform-admin": "node scripts/check-s4d-platform-admin.mjs",
    "check:s403-commerce-billing": "node scripts/check-s403-commerce-billing.mjs",
    "check:s406-sandbox-payment": "node scripts/check-s406-sandbox-payment.mjs",
    "check:architecture": "node scripts/check-architecture.mjs && node scripts/backend.mjs test ./tests/architecture",
    "check": "pnpm check:toolchain && pnpm check:workspace && pnpm check:docs && pnpm check:contracts && pnpm check:g3 && pnpm check:alpha-operations && pnpm check:alpha && pnpm check:s4a-plugin-publication && pnpm check:s4b-release-governance && pnpm check:s4c-dangerous-operation-jit && pnpm check:s4d-platform-admin && pnpm check:s403-commerce-billing && pnpm check:s406-sandbox-payment && pnpm check:architecture && pnpm lint && pnpm typecheck && pnpm test && pnpm test:backend && pnpm vet:backend && pnpm build:backend && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "yaml": "2.9.0"
  }
}
